# Core dataset settings
TARGET_PROTEASE=S01.247
TRIM_LEN=160
RANDOM_SEED=42
CSV_CHUNK_SIZE=500
OUTPUT_DIR=./proteases

# `static` reproduces the substrate list that the legacy script actually used.
# Use `mysql` to read SELECT uniprot_acc, p1 FROM cleavage WHERE code = ...
SUBSTRATE_SOURCE=static

# Needed only when SUBSTRATE_SOURCE=mysql
MEROPS_DB_HOST=localhost
MEROPS_DB_PORT=3306
MEROPS_DB_USER=root
MEROPS_DB_PASSWORD=change_me
MEROPS_DB_NAME=meropsweb121

UNIPROT_TIMEOUT_SEC=30
